<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vishnu Ka Science Notes</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f7fb;
      color: #222;
    }

    header {
      background: #2563eb;
      color: white;
      padding: 25px 15px;
      text-align: center;
    }

    header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 15px;
    }

    .tabs {
      display: flex;
      justify-content: center;
      gap: 10px;
      padding: 15px;
      background: white;
      box-shadow: 0 2px 8px #ddd;
    }

    .tabs button {
      border: none;
      padding: 12px 22px;
      border-radius: 8px;
      background: #e5e7eb;
      cursor: pointer;
      font-weight: bold;
    }

    .tabs button.active {
      background: #2563eb;
      color: white;
    }

    .content {
      max-width: 900px;
      margin: 25px auto;
      padding: 15px;
    }

    .card {
      background: white;
      padding: 20px;
      margin-bottom: 15px;
      border-radius: 12px;
      box-shadow: 0 3px 12px #ddd;
    }

    .card h2 {
      color: #2563eb;
      margin-bottom: 10px;
    }

    .btn {
      display: inline-block;
      margin-top: 12px;
      padding: 10px 18px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 7px;
    }

    footer {
      text-align: center;
      padding: 20px;
      margin-top: 30px;
      background: #111827;
      color: white;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }
  </style>
</head>

<body>

  <header>
    <h1>📚 Vishnu Ka Science Notes</h1>
    <p>Class 10 CBSE • NCERT Science Notes</p>
  </header>

  <div class="tabs">
    <button class="active" onclick="showPage('notes', this)">📖 Notes</button>
    <button onclick="showPage('about', this)">ℹ️ About</button>
  </div>

  <div class="content">

    <!-- NOTES TAB -->
    <div id="notes" class="page active">

      <div class="card">
        <h2>🔬 Class 10 Science</h2>
        <p>Complete Science study material and notes.</p>
      </div>

      <div class="card">
        <h2>Chapter 1 – Chemical Reactions</h2>
        <p>Class 10 CBSE NCERT Science notes.</p>
        <a class="btn" href="#">View Notes</a>
      </div>

      <div class="card">
        <h2>Chapter 2 – Acids, Bases and Salts</h2>
        <p>Important concepts, definitions and questions.</p>
        <a class="btn" href="#">View Notes</a>
      </div>

      <div class="card">
        <h2>Chapter 3 – Metals and Non-metals</h2>
        <p>Complete chapter notes for revision.</p>
